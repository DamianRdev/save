<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet is only used for local metadata extraction (Jsoup) and thumbnail previews (Coil) -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".SaveApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@android:drawable/ic_menu_save"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/ic_menu_save"
        android:supportsRtl="true"
        android:theme="@style/Theme.Save">

        <!-- Main Vault Browser Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Save"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Fast Share Sheet Receiver (Transparent BottomSheet Dialog) -->
        <activity
            android:name=".ui.share.QuickShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_title"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Save.Transparent"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

    </application>

</manifest>
